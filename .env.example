# ── Backend API ───────────────────────────────────────────────────────
# Origin of the NestJS API. Locally that is http://localhost:2024.
NEXT_PUBLIC_API_URL=

# ── Sentry ────────────────────────────────────────────────────────────
# Build-time only, and the single real secret in this file: it authorises
# uploading source maps. Without it the build still succeeds — browser
# stack traces just stay minified and unreadable. On Vercel it lives in
# the project's environment variables; locally, in .env.local.
SENTRY_AUTH_TOKEN=

# The DSN is NOT here on purpose: it is hardcoded in sentry.server.config.ts,
# sentry.edge.config.ts and src/instrumentation-client.ts. A DSN is not a
# secret (it ships to the browser anyway), and keeping it in code means one
# less variable that can be forgotten in a deploy.

# NEXT_PUBLIC_VERCEL_ENV is also absent on purpose: Vercel injects it, and
# the Sentry configs use it to decide whether to report at all. Setting it
# by hand would make a local build look like production.

# ── Optional ──────────────────────────────────────────────────────────
# 1 = let localhost report to Sentry. Off by default so development noise
# stays out of the production dashboard; set it only to test reporting.
NEXT_PUBLIC_SENTRY_DEV=

# Version string shown in the UI. Safe to leave empty.
NEXT_PUBLIC_APP_VERSION=
